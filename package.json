{
  "name": "cmchen-translate",
  "version": "1.0.0",
  "private": true,
  "description": "跨平台划词翻译 + 截图 OCR 翻译（Electron，支持 Windows/macOS/Linux）",
  "main": "src/main.js",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "e2e": "node scripts/e2e-gateway.js",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "stage:tessdata": "node scripts/stage-tessdata.js"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "koffi": "3.1.6",
    "tesseract.js": "7.0.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cmchen.translate",
    "productName": "划译",
    "directories": {
      "output": "release-builder",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "scripts/**"
    ],
    "files": [
      "src/**/*",
      "scripts/ocr.ps1",
      "scripts/stage-tessdata.js",
      "build/tessdata/**",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "cmchen-translate-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "cmchen-translate-portable-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "cmchen-translate-${version}-${arch}.${ext}"
    },
    "zip": {
      "artifactName": "cmchen-translate-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icons",
      "category": "Utility",
      "executableName": "cmchen-translate"
    },
    "appImage": {
      "artifactName": "cmchen-translate-${version}.${ext}"
    },
    "deb": {
      "artifactName": "cmchen-translate-${version}.${ext}"
    }
  },
  "author": {
    "name": "cmchen",
    "email": "2425698138@qq.com"
  }
}
