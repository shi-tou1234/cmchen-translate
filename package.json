{
  "name": "huayi",
  "version": "1.0.0",
  "private": true,
  "description": "划译 - Windows 划词翻译工具",
  "main": "src/main.js",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "e2e": "node scripts/e2e-gateway.js",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"
  },
  "dependencies": {
    "koffi": "3.1.6",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.huayi.translate",
    "productName": "划译",
    "directories": {
      "output": "release-builder",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "scripts/ocr.ps1",
      "build/**",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "划译.exe"
    }
  }
}
